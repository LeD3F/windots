theme
{
	name = "modern"

	view = view.large

	background
	{
		color = #18181b
		opacity = 100
		// effect = 2
	}

	item
	{
		opacity = 100
		radius = 0
		prefix = 1

		text
		{
			normal = #e5e7eb
			select = #e5e7eb
			normal-disabled = #b2b2b2
			select-disabled = #b2b2b2
		}

		back
		{
			select = #7a7c7d
			select-disabled = #7a7c7d
		}
	}

	font
	{
		size = 24
	 	name = "JetBrainsMono NFP"
	 	weight = 1
	 	italic = 0
	 }

	border
	{
		enabled = true
		size = 2
		color = #3f3f42
		opacity = 100
		radius = 0
	}

	shadow
	{
		enabled = true
		size = 5
		opacity = 5
		color = #11111b
	}

	separator
	{
		size = 1
		color = #7a7c7d
	}

	symbol
	{
		normal = #e5e7eb
		select = #e5e7eb
		normal-disabled = #e5e7eb7a
		select-disabled = #e5e7eb7a
	}

	image
	{
		enabled = false
		color = [#e5e7eb, #e5e7eb, #e5e7eb]
	}
}